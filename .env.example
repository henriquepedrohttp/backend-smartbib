# Backend SmartBib
# Copie este arquivo para .env e ajuste os valores conforme necessario

# Porta do servidor Express (padrao: 3000)
PORT=3000

# Chave secreta para assinatura dos tokens JWT
# Altere para um valor seguro em producao
JWT_SECRET=smartbib-secret-key-2025

# URL de conexao com o PostgreSQL (Prisma)
# Desenvolvimento local (Docker):
DATABASE_URL=postgresql://smartbib:smartbib123@localhost:5432/smartbib
# Producao (AWS RDS):
# DATABASE_URL=postgresql://usuario:senha@HOST_RDS:5432/smartbib

# URL do broker MQTT (padrao: broker publico HiveMQ)
# MQTT_BROKER=mqtt://broker.hivemq.com:1883
