# Backend SmartBib
# Copie este arquivo para .env e ajuste os valores conforme necessário

# Porta do servidor Express (padrão: 3000)
PORT=3000

# Chave secreta para assinatura dos tokens JWT
# Altere para um valor seguro em produção
JWT_SECRET=smartbib-secret-key-2025

# URL do broker MQTT (padrão: broker público HiveMQ)
# MQTT_BROKER=mqtt://broker.hivemq.com:1883
